# 复制本文件为根目录 .env，仅在本机填写；禁止提交 .env。
HOST=127.0.0.1
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=party_question_bank

# 可选：留空时使用本地知识库问答。密钥只由后端读取。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000

# 可选：留空时每次启动生成临时签名密钥，重启后需要重新登录。
TOKEN_SECRET=
# 创建管理员时使用；留空则生成随机密码并仅在本机终端显示。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
